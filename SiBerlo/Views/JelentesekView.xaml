<!-- JelentesekView.xaml -->
<UserControl x:Class="SiBerlo.Views.JelentesekView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:lvc="clr-namespace:LiveCharts.Wpf;assembly=LiveCharts.Wpf"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <ScrollViewer>
        <StackPanel Margin="16">
            <!-- Fejléc -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                <materialDesign:PackIcon Kind="ChartAreaspline" 
                                         Width="32"
                                         Height="32"
                                         Margin="0 0 8 0"/>
                <TextBlock Text="Kimutatások" 
                           FontSize="24"
                           VerticalAlignment="Center"/>
            </StackPanel>

            <!-- Gombok -->
            <StackPanel Orientation="Horizontal" Margin="0 0 0 16">
                <Button Command="{Binding FrissitesParancs}"
                        Style="{StaticResource MaterialDesignRaisedButton}"
                        Margin="0 0 8 0">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="Refresh" 
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0 0 4 0"/>
                        <TextBlock Text="Frissítés"/>
                    </StackPanel>
                </Button>
                <Button Command="{Binding ExportPdfParancs}"
                        Style="{StaticResource MaterialDesignRaisedButton}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon Kind="FilePdfBox" 
                                                 Width="16"
                                                 Height="16"
                                                 Margin="0 0 4 0"/>
                        <TextBlock Text="Exportálás PDF-ként"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <!-- Havi bevétel diagram -->
            <GroupBox Header="Havi bevétel" Margin="0 0 0 16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <lvc:CartesianChart Series="{Binding HavibevetelSorozat}" 
                                       LegendLocation="Right">
                        <lvc:CartesianChart.AxisX>
                            <lvc:Axis Title="Hónap" 
                                     Labels="{Binding HavibevetelCimkek}"/>
                        </lvc:CartesianChart.AxisX>
                        <lvc:CartesianChart.AxisY>
                            <lvc:Axis Title="Bevétel (Ft)"/>
                        </lvc:CartesianChart.AxisY>
                    </lvc:CartesianChart>

                    <DataGrid Grid.Column="1" 
                              ItemsSource="{Binding Havibevetelek}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Width="300"
                              Margin="8 0 0 0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Év" Binding="{Binding Ev}"/>
                            <DataGridTextColumn Header="Hónap" Binding="{Binding Honap}"/>
                            <DataGridTextColumn Header="Összeg" Binding="{Binding Osszeg, StringFormat=N0}"/>
                            <DataGridTextColumn Header="Darab" Binding="{Binding Darab}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- Bérlési statisztikák -->
            <GroupBox Header="Bérlési statisztikák" Margin="0 0 0 16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <lvc:PieChart Grid.Column="0"
                        Series="{Binding BerlesStatisztikaSorozat}" 
                        LegendLocation="Right"
                        InnerRadius="100"
                        Hoverable="True"
                        DataTooltip="{x:Null}"
                        VerticalAlignment="Center"
                        Height="300"
                        Margin="8"/>

                    <DataGrid Grid.Column="1" 
                              ItemsSource="{Binding BerlesStatisztikak}"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              Width="400"
                              Margin="8 0 0 0">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Típus" Binding="{Binding FelszerelesTipus}"/>
                            <DataGridTextColumn Header="Átlagos nap" Binding="{Binding AtlagosBérletiIdo, StringFormat=N1}"/>
                            <DataGridTextColumn Header="Összbevétel" Binding="{Binding OsszBevetel, StringFormat=N0}"/>
                            <DataGridTextColumn Header="Ügyfelek" Binding="{Binding UgyfelekSzama}"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>

            <!-- Felszerelés használat -->
            <GroupBox Header="Felszerelés használat" Margin="0 0 0 16">
                <DataGrid ItemsSource="{Binding FelszerelesHasznalatok}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Típus" Binding="{Binding Tipus}"/>
                        <DataGridTextColumn Header="Méret" Binding="{Binding Meret}"/>
                        <DataGridTextColumn Header="Bérlések" Binding="{Binding BerlesekSzama}"/>
                        <DataGridTextColumn Header="Használt napok" Binding="{Binding OsszesHasznaltNap, StringFormat=N1}"/>
                        <DataGridTextColumn Header="Állapot" Binding="{Binding Allapot}"/>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>

            <!-- Alkalmazott teljesítmény -->
            <GroupBox Header="Alkalmazott teljesítmény" Margin="0 0 0 16">
                <DataGrid ItemsSource="{Binding AlkalmazottTeljesitmenyek}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Név" Binding="{Binding Nev}"/>
                        <DataGridTextColumn Header="Beosztás" Binding="{Binding Beosztas}"/>
                        <DataGridTextColumn Header="Átlagos óra/nap" Binding="{Binding AtlagosNapiDolgozottOra, StringFormat=N1}"/>
                        <DataGridTextColumn Header="Összbér" Binding="{Binding OsszBér, StringFormat=N0}"/>
                        <DataGridTemplateColumn Header="Aktív">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <materialDesign:PackIcon 
                                        Width="20" Height="20"
                                        Kind="{Binding Aktiv, Converter={StaticResource BoolToIconConverter}}"
                                        Foreground="Gray"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>