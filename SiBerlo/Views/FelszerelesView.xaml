<UserControl x:Class="SiBerlo.Views.FelszerelesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiBerlo.Views"             
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <!-- Add Equipment Form -->
        <Border Grid.Row="0" 
                CornerRadius="4" 
                Padding="16" 
                Background="{DynamicResource MaterialDesignPaper}"
                Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0 0 0 16"/>
                <ComboBox materialDesign:HintAssist.Hint="Típus"
                          ItemsSource="{Binding EquipmentTypes}"
                          SelectedItem="{Binding NewEquipmentType, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 0 8"/>
                <ComboBox materialDesign:HintAssist.Hint="Méret"
                          ItemsSource="{Binding EquipmentSizes}"
                          SelectedItem="{Binding NewEquipmentSize, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 0 8"/>
                <ComboBox materialDesign:HintAssist.Hint="Állapot"
                          ItemsSource="{Binding EquipmentStates}"
                          DisplayMemberPath="Value"  
                          SelectedValuePath="Key"    
                          SelectedValue="{Binding NewEquipmentState, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 0 8"/>
                <TextBox materialDesign:HintAssist.Hint="Beszerzési ár" 
                          Text="{Binding NewEquipmentPurchasePrice, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 0 8"/>
                <TextBox materialDesign:HintAssist.Hint="Napi bérleti díj" 
                          Text="{Binding NewEquipmentRentalPrice, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 0 8"/>
                <TextBox materialDesign:HintAssist.Hint="Raktári hely" 
                          Text="{Binding NewEquipmentStoragePlace, UpdateSourceTrigger=PropertyChanged}"
                          Margin="0 0 0 8"/>
                <CheckBox Content="Selejt" 
                          IsChecked="{Binding NewEquipmentScrap}"
                          Margin="0 0 0 16"
                          materialDesign:CheckBoxAssist.CheckBoxSize="20"/>
                <Button Content="Hozzáadás" 
                        Command="{Binding AddEquipmentCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Frissítés"
                            Command="{Binding UpdateEquipmentCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="Törlés"
                            Command="{Binding DeleteEquipmentCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="Tomato"
                            Foreground="White"/>
                    <Button Content="Mégse"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </StackPanel>
        </Border>
        <!-- Employee List -->
        <TextBlock Grid.Row="1" 
           Text="Felszerelések listája" 
           Style="{StaticResource MaterialDesignSubtitle1TextBlock}"
           Margin="0 0 0 8"/>

        <DataGrid Grid.Row="2" 
          ItemsSource="{Binding Equipment}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectedItem="{Binding SelectedEquipment}" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Típus" Binding="{Binding Tipus}"/>
                <DataGridTextColumn Header="Méret" Binding="{Binding Meret}"/>
                <DataGridTextColumn Header="Állapot" Binding="{Binding Allapot}"/>
                <DataGridTextColumn Header="Beszerzési ár" Binding="{Binding BeszerzesiAr}"/>
                <DataGridTextColumn Header="Napi bérleti díj" Binding="{Binding NapiBerletiDij}"/>
                <DataGridTextColumn Header="Raktári hely" Binding="{Binding RaktariHely}"/>
                <DataGridTemplateColumn Header="Selejt">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon 
                                Width="20" Height="20"
                                Kind="{Binding Selejt, Converter={StaticResource BoolToIconConverter}}"
                                Foreground="Gray"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
