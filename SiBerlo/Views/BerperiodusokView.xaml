<UserControl x:Class="SiBerlo.Views.BerperiodusokView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:SiBerlo.Views"             
             xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" 
                CornerRadius="4" 
                Padding="16" 
                Background="{DynamicResource MaterialDesignPaper}"
                Margin="0 0 0 16">
            <StackPanel>
                <TextBlock Text="{Binding FormTitle}" 
                           Style="{StaticResource MaterialDesignHeadline6TextBlock}"
                           Margin="0 0 0 16"/>

                <TextBox materialDesign:HintAssist.Hint="Név" 
                         Text="{Binding NewBerperiodusNev, UpdateSourceTrigger=PropertyChanged}"
                         Margin="0 0 0 8"/>
                
                <DatePicker materialDesign:HintAssist.Hint="Periódus kezdete"
                            SelectedDate="{Binding NewBerperiodusKezdete, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 0 0 8"/>

                <DatePicker materialDesign:HintAssist.Hint="Periódus vége"
                            SelectedDate="{Binding NewBerperiodusVege, UpdateSourceTrigger=PropertyChanged}"
                            Margin="0 0 0 8"/>
                
                <CheckBox Content="Zárolt" 
                          IsChecked="{Binding BerperiodusZarolt}"
                          Margin="0 0 0 16"
                          materialDesign:CheckBoxAssist.CheckBoxSize="20"/>
                <Button Content="Hozzáadás" 
                        Command="{Binding AddBerperiodusCommand}"
                        HorizontalAlignment="Right"
                        Style="{StaticResource MaterialDesignRaisedButton}"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="Frissítés"
                            Command="{Binding UpdateBerperiodusCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                    <Button Content="Törlés"
                            Command="{Binding DeleteBerperiodusCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}"
                            Background="Tomato"
                            Foreground="White"/>
                    <Button Content="Mégse"
                            Command="{Binding CancelEditCommand}"
                            Style="{StaticResource MaterialDesignRaisedButton}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <DataGrid Grid.Row="2" 
          ItemsSource="{Binding Berperiodusok}"
          AutoGenerateColumns="False"
          IsReadOnly="True"
          SelectionMode="Single"
          SelectedItem="{Binding SelectedBerperiodus}" >
            <DataGrid.Columns>
                <DataGridTextColumn Header="ID" Binding="{Binding Id}"/>
                <DataGridTextColumn Header="Név" Binding="{Binding Nev}"/>
                <DataGridTextColumn Header="Periódus kezdete" Binding="{Binding KezdoDatum}"/>
                <DataGridTextColumn Header="Periódus vége" Binding="{Binding VegDatum}"/>
                <DataGridTemplateColumn Header="Zárolt">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <materialDesign:PackIcon 
                            Width="20" Height="20"
                            Kind="{Binding Zarolt, Converter={StaticResource BoolToIconConverter}}"
                            Foreground="Gray"/>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>
